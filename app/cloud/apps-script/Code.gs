function doGet(e){var action=String(e&&e.parameter&&e.parameter.action||'app');if(action==='health')return output_({ok:true,service:'TH-Agri-Risk-Maps-Burning',mode:'workspace-control-plane',version:2},e);if(action==='catalog')return output_(publicCatalog_(),e);if(action==='hotspots')return output_(publicHotspots_(String(e.parameter.provinceCode||'')),e);return HtmlService.createTemplateFromFile('Index').evaluate().setTitle('Thailand Agri-Risk Maps Burning · ลงทะเบียนและจัดการข้อมูล').setXFrameOptionsMode(HtmlService.XFrameOptionsMode.DEFAULT);}
function include_(name){return HtmlService.createHtmlOutputFromFile(name).getContent();}
function output_(value,e){var json=JSON.stringify(value),callback=String(e&&e.parameter&&e.parameter.callback||'');if(callback){if(!/^[A-Za-z_$][0-9A-Za-z_$\.]{0,79}$/.test(callback))return ContentService.createTextOutput('invalid callback').setMimeType(ContentService.MimeType.TEXT);return ContentService.createTextOutput(callback+'('+json+');').setMimeType(ContentService.MimeType.JAVASCRIPT);}return ContentService.createTextOutput(json).setMimeType(ContentService.MimeType.JSON);}

function api(action,payload){payload=payload||{};try{if(action==='register')return register_(payload);if(action==='registrationStatus')return registrationStatus_(payload);if(action==='login')return login_(payload);if(action==='logout')return logout_(payload);var session=requireSession_(payload.sessionToken);if(action==='mySession')return{ok:true,session:publicAccount_(session)};if(action==='listProvinceRegistry')return listProvinceRegistry_(session);if(action==='listRequests')return listRequests_(session);if(action==='decideRequest')return decideRequest_(session,payload);if(action==='approveRequest')return decideRequest_(session,Object.assign({},payload,{decision:'approved'}));if(action==='listAccounts')return listAccounts_(session);if(action==='setAccountStatus')return setAccountStatus_(session,payload);if(action==='resetDevice')return resetDevice_(session,payload);if(action==='listHotspots')return listHotspots_(session,payload);if(action==='saveHotspots')return saveHotspots_(session,payload);if(action==='submitHotspots')return transitionHotspots_(session,payload,'submitted');if(action==='approveHotspots')return transitionHotspots_(session,payload,'approved');if(action==='deleteHotspots')return deleteHotspots_(session,payload);if(action==='restoreHotspots')return restoreHotspots_(session,payload);if(action==='publishHotspots')return publishHotspots_(session,payload);if(action==='dashboard')return dashboard_(session,payload);throw new Error('ไม่รู้จักคำสั่งที่ร้องขอ');}catch(error){return{ok:false,error:String(error&&error.message||error)};}}

function normalizePhone_(value){var thai='๐๑๒๓๔๕๖๗๘๙',digits=String(value||'').replace(/[๐-๙]/g,function(c){return String(thai.indexOf(c));}).replace(/\D/g,'');if(!/^0[689]\d{8}$/.test(digits))throw new Error('หมายเลขโทรศัพท์มือถือไม่ถูกต้อง');return digits;}
function digest_(value){var bytes=Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,String(value),Utilities.Charset.UTF_8);return Utilities.base64EncodeWebSafe(bytes).replace(/=+$/,'');}
function pepper_(){var value=PropertiesService.getScriptProperties().getProperty('AUTH_PEPPER');if(!value)throw new Error('ระบบยังไม่ได้ตั้งค่า AUTH_PEPPER');return value;}
function hashPhone_(phone){return digest_(pepper_()+'|phone|'+normalizePhone_(phone));}
function hashSecret_(label,value){return digest_(pepper_()+'|'+label+'|'+String(value||''));}
function strictBoolean_(value,defaultValue){if(value===undefined||value===null||value==='')return Boolean(defaultValue);if(value===true||value===false)return value;throw new Error('สถานะเผยแพร่ต้องเป็น true หรือ false เท่านั้น');}
function activationExpiry_(){return new Date(Date.now()+ACTIVATION_DAYS*86400000).toISOString();}
function loginKey_(kind,identifier){return'login-fail:'+kind+':'+hashSecret_('login-limit',identifier);}
function assertLoginAllowed_(key){if(Number(CacheService.getScriptCache().get(key)||0)>=LOGIN_MAX_FAILURES)throw new Error('ลองเข้าสู่ระบบหลายครั้งเกินไป กรุณารอ 15 นาที');}
function recordLoginFailure_(key){var cache=CacheService.getScriptCache(),count=Number(cache.get(key)||0)+1;cache.put(key,String(count),LOGIN_WINDOW_SECONDS);}
function clearLoginFailures_(key){CacheService.getScriptCache().remove(key);}

function validateRegistration_(payload,noticeVersion,existingKeys){if(!payload.acknowledged||String(payload.noticeVersion)!==String(noticeVersion))throw new Error('กรุณาอ่านและรับทราบประกาศฉบับปัจจุบัน');var key=String(payload.idempotencyKey||'').trim();if(!/^[A-Za-z0-9_-]{12,100}$/.test(key))throw new Error('รหัสป้องกันการส่งซ้ำไม่ถูกต้อง');var name=String(payload.fullName||'').trim();if(name.length<3||name.length>120)throw new Error('กรุณาระบุชื่อ-สกุล');var position=String(payload.position||'').trim(),allowed=['นักวิชาการส่งเสริมการเกษตร','นักวิชาการเกษตร','เกษตรอำเภอ','อื่นๆ'];if(allowed.indexOf(position)<0)throw new Error('ตำแหน่งไม่ถูกต้อง');var other=String(payload.positionOther||'').trim();if(position==='อื่นๆ'&&!other)throw new Error('กรุณาระบุตำแหน่งอื่น');var affiliation=String(payload.affiliation||'').trim();if(['สำนักงานเกษตรอำเภอ','สำนักงานเกษตรจังหวัด'].indexOf(affiliation)<0)throw new Error('สังกัดไม่ถูกต้อง');var code=String(payload.provinceCode||'');if(!/^\d{2}$/.test(code))throw new Error('จังหวัดไม่ถูกต้อง');return{duplicate:existingKeys.has(key),idempotencyKey:key,fullName:name,phone:normalizePhone_(payload.phone),position:position,positionOther:other,affiliation:affiliation,provinceCode:code};}
function scopeAllows_(actor,provinceCode){return!!actor&&actor.status==='approved'&&(actor.role==='superadmin'||(actor.role==='admin'&&actor.provinceCode===String(provinceCode||'')));}
function sessionValid_(session,now){return!!session&&Number(session.expiresAt)>Number(now);}
function sessionAuthorityMatches_(session,current){return!!current&&current.status==='approved'&&current.role==='admin'&&Number(current.revision)===Number(session.revision)&&String(current.provinceCode)===String(session.provinceCode)&&String(current.deviceTokenHash)===String(session.deviceTokenHash);}
function publicAccount_(row){return{accountId:row.accountId,fullName:row.fullName,role:row.role,provinceCode:row.provinceCode};}

function spreadsheet_(){var id=PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID');if(!id)throw new Error('ระบบยังไม่ได้ตั้งค่า SPREADSHEET_ID');return SpreadsheetApp.openById(id);}
function sheet_(name){var book=spreadsheet_(),sheet=book.getSheetByName(name);if(!sheet)sheet=book.insertSheet(name);var expected=SHEETS[name];if(!expected)throw new Error('Unknown table '+name);if(sheet.getLastRow()===0)sheet.getRange(1,1,1,expected.length).setValues([expected]);var actual=sheet.getRange(1,1,1,expected.length).getDisplayValues()[0];if(expected.join('|')!==actual.join('|'))throw new Error('โครงสร้างชีต '+name+' ไม่ตรงกับระบบ');sheet.setFrozenRows(1);return sheet;}
function rows_(name){var sheet=sheet_(name),values=sheet.getDataRange().getValues(),headers=values.shift().map(String);return values.map(function(row,index){var value={_row:index+2};headers.forEach(function(header,column){value[header]=row[column];});return value;}).filter(function(row){return Object.keys(row).some(function(key){return key!=='_row'&&row[key]!=='';});});}
function append_(name,value){var sheet=sheet_(name),headers=SHEETS[name];sheet.appendRow(headers.map(function(header){return value[header]===undefined?'':value[header];}));}
function update_(name,rowNumber,patch){var sheet=sheet_(name),headers=SHEETS[name],values=sheet.getRange(rowNumber,1,1,headers.length).getValues()[0];headers.forEach(function(header,index){if(Object.prototype.hasOwnProperty.call(patch,header))values[index]=patch[header];});sheet.getRange(rowNumber,1,1,headers.length).setValues([values]);}
function now_(){return new Date().toISOString();}function random_(){return Utilities.getUuid().replace(/-/g,'')+Utilities.getUuid().replace(/-/g,'');}
function registry_(code){return rows_('ProvinceRegistry').find(function(row){return String(row.provinceCode)===String(code);});}
function provinceBook_(code){var row=registry_(code);if(!row||!row.dataSpreadsheetId)throw new Error('จังหวัดนี้ยังไม่ได้เปิด Data Plane');return SpreadsheetApp.openById(String(row.dataSpreadsheetId));}
function provinceSheet_(code,name){var book=provinceBook_(code),sheet=book.getSheetByName(name),headers=PROVINCE_SHEETS[name];if(!sheet||!headers)throw new Error('ไม่พบตารางจังหวัด '+name);var actual=sheet.getRange(1,1,1,headers.length).getDisplayValues()[0];if(actual.join('|')!==headers.join('|'))throw new Error('โครงสร้างตารางจังหวัดไม่ตรงกับระบบ');return sheet;}
function provinceRows_(code,name){var sheet=provinceSheet_(code,name),values=sheet.getDataRange().getValues(),headers=values.shift().map(String);return values.map(function(row,index){var value={_row:index+2};headers.forEach(function(h,c){value[h]=row[c];});return value;}).filter(function(row){return Object.keys(row).some(function(k){return k!=='_row'&&row[k]!=='';});});}
function provinceAppend_(code,name,value){var sheet=provinceSheet_(code,name),headers=PROVINCE_SHEETS[name];sheet.appendRow(headers.map(function(h){return value[h]===undefined?'':value[h];}));}
function provinceUpdate_(code,name,rowNumber,patch){var sheet=provinceSheet_(code,name),headers=PROVINCE_SHEETS[name],values=sheet.getRange(rowNumber,1,1,headers.length).getValues()[0];headers.forEach(function(h,i){if(Object.prototype.hasOwnProperty.call(patch,h))values[i]=patch[h];});sheet.getRange(rowNumber,1,1,headers.length).setValues([values]);}
function provinceCodeFor_(actor,payload){var code=String(payload&&payload.provinceCode||actor.provinceCode||'');if(!/^\d{2}$/.test(code)||!scopeAllows_(actor,code))throw new Error('จังหวัดอยู่นอกสิทธิ์');return code;}
function provinceAudit_(actor,code,action,targetId,result,reason,beforeValue,afterValue){provinceAppend_(code,'ProvinceAudit',{timestamp:now_(),correlationId:Utilities.getUuid(),actorId:actor.accountId,roleIds:actor.role,targetType:'Hotspot',targetId:targetId||'batch',action:action,result:result,reason:reason||'',beforeJson:beforeValue?JSON.stringify(beforeValue):'',afterJson:afterValue?JSON.stringify(afterValue):''});audit_(actor,action,'Hotspot',targetId||'batch',code,result);}
function refreshRegistry_(code){var rows=provinceRows_(code,'Hotspots'),active=rows.filter(function(row){return !row.deletedAt;}),published=active.filter(function(row){return row.workflowStatus==='published';}),draft=active.length-published.length,latest=active.map(function(row){return String(row.updatedAt||row.createdAt||'');}).sort().pop()||'',entry=registry_(code);if(entry)update_('ProvinceRegistry',entry._row,{publishedCount:published.length,draftCount:draft,lastDataAt:latest,lastPublishedAt:published.map(function(row){return String(row.publishedAt||'');}).sort().pop()||entry.lastPublishedAt,updatedAt:now_()});}

function register_(payload){var lock=LockService.getScriptLock();lock.waitLock(10000);try{var existing=rows_('RegistrationRequests'),keys=new Set(existing.map(function(row){return String(row.idempotencyKey);})),value=validateRegistration_(payload,PropertiesService.getScriptProperties().getProperty('NOTICE_VERSION')||NOTICE_VERSION,keys),prior=existing.find(function(row){return String(row.idempotencyKey)===value.idempotencyKey;});if(prior)return{ok:true,duplicate:true,requestId:prior.requestId,status:prior.status};var requestId='R-'+Utilities.getUuid();append_('RegistrationRequests',{requestId:requestId,idempotencyKey:value.idempotencyKey,phoneHash:hashPhone_(value.phone),fullName:value.fullName,position:value.position,positionOther:value.positionOther,affiliation:value.affiliation,provinceCode:value.provinceCode,noticeVersion:payload.noticeVersion,acknowledgedAt:now_(),status:'pending',createdAt:now_()});audit_({accountId:'public'},'register','RegistrationRequest',requestId,value.provinceCode,'pending');return{ok:true,duplicate:false,requestId:requestId,status:'pending'};}finally{lock.releaseLock();}}
function registrationStatus_(payload){var key=String(payload.idempotencyKey||''),row=rows_('RegistrationRequests').find(function(value){return String(value.idempotencyKey)===key;});return row?{ok:true,found:true,requestId:row.requestId,status:row.status}:{ok:true,found:false};}

function login_(payload){var properties=PropertiesService.getScriptProperties(),actor,key,lock;try{if(payload.username){key=loginKey_('owner',String(payload.username||''));assertLoginAllowed_(key);if(String(payload.username)!==properties.getProperty('OWNER_USERNAME')||hashSecret_('owner-password',payload.password)!==properties.getProperty('OWNER_PASSWORD_HASH'))throw new Error('ชื่อผู้ใช้หรือรหัสผ่านไม่ถูกต้อง');actor={accountId:'OWNER',fullName:String(payload.username),role:'superadmin',provinceCode:'',status:'approved',revision:Number(properties.getProperty('OWNER_AUTH_REVISION')||1)};}else{var phoneHash=hashPhone_(payload.phone);key=loginKey_('admin',phoneHash);assertLoginAllowed_(key);lock=LockService.getScriptLock();lock.waitLock(10000);var accounts=rows_('Accounts');actor=accounts.find(function(row){return row.phoneHash===phoneHash&&row.status==='approved';});if(!actor)throw new Error('บัญชียังไม่ได้รับอนุมัติหรือหมายเลขไม่ถูกต้อง');var deviceToken=String(payload.deviceToken||'');if(deviceToken.length<32)throw new Error('อุปกรณ์นี้ยังไม่มีรหัสยืนยัน');var deviceHash=hashSecret_('device',deviceToken);if(!actor.deviceTokenHash){if(!actor.activationHash||!payload.activationCode||hashSecret_('activation',payload.activationCode)!==actor.activationHash)throw new Error('กรุณาระบุรหัสเปิดใช้งานครั้งแรกจาก Super Admin');if(!actor.activationExpiresAt||new Date(actor.activationExpiresAt).getTime()<=Date.now())throw new Error('รหัสเปิดใช้งานหมดอายุ กรุณาขอรหัสใหม่');var nextRevision=Number(actor.revision||0)+1;update_('Accounts',actor._row,{deviceTokenHash:deviceHash,activationHash:'',activationExpiresAt:'',revision:nextRevision});actor.deviceTokenHash=deviceHash;actor.revision=nextRevision;}else if(actor.deviceTokenHash!==deviceHash)throw new Error('อุปกรณ์นี้ยังไม่ได้รับอนุญาต กรุณาขอรหัสเปิดใช้งานใหม่');}
 if(actor.role==='admin'&&actor._row)update_('Accounts',actor._row,{lastLoginAt:now_(),updatedAt:now_()});clearLoginFailures_(key);var token=random_(),session={accountId:actor.accountId,fullName:actor.fullName,role:actor.role,provinceCode:String(actor.provinceCode||''),status:'approved',revision:Number(actor.revision||1),deviceTokenHash:String(actor.deviceTokenHash||''),expiresAt:Date.now()+SESSION_SECONDS*1000};CacheService.getScriptCache().put('session:'+hashSecret_('session',token),JSON.stringify(session),SESSION_SECONDS);audit_(session,'login','Session',session.accountId,session.provinceCode,'success');return{ok:true,sessionToken:token,session:publicAccount_(session),expiresAt:session.expiresAt};}catch(error){if(key)recordLoginFailure_(key);throw error;}finally{if(lock)lock.releaseLock();}}
function requireSession_(token){var raw=CacheService.getScriptCache().get('session:'+hashSecret_('session',String(token||''))),session=raw&&JSON.parse(raw);if(!sessionValid_(session,Date.now()))throw new Error('เซสชันหมดอายุ กรุณาเข้าสู่ระบบใหม่');if(session.role==='superadmin'){var revision=Number(PropertiesService.getScriptProperties().getProperty('OWNER_AUTH_REVISION')||1);if(session.accountId!=='OWNER'||Number(session.revision)!==revision)throw new Error('สิทธิ์บัญชีมีการเปลี่ยนแปลง กรุณาเข้าสู่ระบบใหม่');return session;}var current=rows_('Accounts').find(function(row){return String(row.accountId)===String(session.accountId);});if(!sessionAuthorityMatches_(session,current))throw new Error('สิทธิ์บัญชีมีการเปลี่ยนแปลง กรุณาเข้าสู่ระบบใหม่');return session;}
function logout_(payload){if(payload.sessionToken)CacheService.getScriptCache().remove('session:'+hashSecret_('session',payload.sessionToken));return{ok:true};}
function listRequests_(actor){if(actor.role!=='superadmin')throw new Error('เฉพาะ Super Admin');return{ok:true,requests:rows_('RegistrationRequests').map(function(row){return{requestId:row.requestId,fullName:row.fullName,position:row.position,positionOther:row.positionOther,affiliation:row.affiliation,provinceCode:String(row.provinceCode),noticeVersion:row.noticeVersion,status:row.status,createdAt:row.createdAt};})};}
function decideRequest_(actor,payload){if(actor.role!=='superadmin')throw new Error('เฉพาะ Super Admin');var decision=String(payload.decision||'');if(['approved','rejected','needs_revision'].indexOf(decision)<0)throw new Error('ผลพิจารณาไม่ถูกต้อง');var lock=LockService.getScriptLock();lock.waitLock(10000);try{var request=rows_('RegistrationRequests').find(function(row){return row.requestId===payload.requestId;});if(!request||['pending','needs_revision'].indexOf(String(request.status))<0)throw new Error('ไม่พบคำขอที่รอพิจารณา');var reason=String(payload.reason||'').trim();if(decision!=='approved'&&!reason)throw new Error('กรุณาระบุเหตุผล');var patch={status:decision,decisionReason:reason,decidedAt:now_(),decidedBy:actor.accountId};if(decision!=='approved'){update_('RegistrationRequests',request._row,patch);audit_(actor,'registration_'+decision,'RegistrationRequest',request.requestId,String(request.provinceCode),'success');return{ok:true,status:decision};}var activationCode=random_().slice(0,16),accountId='A-'+Utilities.getUuid(),scope='["'+String(request.provinceCode)+'"]';append_('Accounts',{accountId:accountId,phoneHash:request.phoneHash,fullName:request.fullName,position:request.position,positionOther:request.positionOther,affiliation:request.affiliation,provinceCode:String(request.provinceCode),districtCodes:'',role:'admin',status:'approved',revision:1,deviceTokenHash:'',activationHash:hashSecret_('activation',activationCode),createdAt:request.createdAt,approvedAt:now_(),activationExpiresAt:activationExpiry_(),roleIds:'["province_admin"]',provinceScopes:scope,lastLoginAt:'',updatedAt:now_()});update_('RegistrationRequests',request._row,patch);audit_(actor,'approve','Account',accountId,String(request.provinceCode),'success');return{ok:true,status:decision,account:publicAccount_({accountId:accountId,fullName:request.fullName,role:'admin',provinceCode:String(request.provinceCode)}),activationCode:activationCode};}finally{lock.releaseLock();}}
function listAccounts_(actor){if(actor.role!=='superadmin')throw new Error('เฉพาะ Super Admin');return{ok:true,accounts:rows_('Accounts').map(publicAccount_)};}
function listProvinceRegistry_(actor){return{ok:true,provinces:rows_('ProvinceRegistry').filter(function(row){return actor.role==='superadmin'||String(row.provinceCode)===String(actor.provinceCode);}).map(function(row){return{provinceCode:String(row.provinceCode),provinceNameTH:String(row.provinceNameTH),status:String(row.status),dataPlaneReady:Boolean(row.dataSpreadsheetId),publishedCount:Number(row.publishedCount||0),draftCount:Number(row.draftCount||0)};})};}
function setAccountStatus_(actor,payload){if(actor.role!=='superadmin')throw new Error('เฉพาะ Super Admin');var status=String(payload.status||'');if(['approved','disabled'].indexOf(status)<0)throw new Error('สถานะบัญชีไม่ถูกต้อง');var row=rows_('Accounts').find(function(value){return String(value.accountId)===String(payload.accountId);});if(!row)throw new Error('ไม่พบบัญชี');update_('Accounts',row._row,{status:status,revision:Number(row.revision||0)+1,updatedAt:now_()});audit_(actor,'account_'+status,'Account',row.accountId,String(row.provinceCode),'success');return{ok:true,status:status};}
function resetDevice_(actor,payload){if(actor.role!=='superadmin')throw new Error('เฉพาะ Super Admin');var row=rows_('Accounts').find(function(value){return String(value.accountId)===String(payload.accountId);});if(!row)throw new Error('ไม่พบบัญชี');var activationCode=random_().slice(0,16),expiresAt=activationExpiry_();update_('Accounts',row._row,{deviceTokenHash:'',activationHash:hashSecret_('activation',activationCode),activationExpiresAt:expiresAt,revision:Number(row.revision||0)+1,updatedAt:now_()});audit_(actor,'reset_device','Account',row.accountId,String(row.provinceCode),'success');return{ok:true,activationCode:activationCode,expiresAt:expiresAt};}

function validateHotspot_(row){var provinceCode=String(row.provinceCode||''),districtCode=String(row.districtCode||''),subdistrictCode=String(row.subdistrictCode||'');if(!/^\d{2}$/.test(provinceCode)||!/^\d{4}$/.test(districtCode)||districtCode.slice(0,2)!==provinceCode)throw new Error('รหัสพื้นที่ไม่ถูกต้อง');if(subdistrictCode&&(!/^\d{6}$/.test(subdistrictCode)||subdistrictCode.slice(0,4)!==districtCode))throw new Error('รหัสตำบลไม่ถูกต้อง');var latitude=Number(row.latitude),longitude=Number(row.longitude);if(!Number.isFinite(latitude)||!Number.isFinite(longitude)||latitude<0||latitude>25||longitude<90||longitude>110)throw new Error('พิกัดไม่ถูกต้อง');if(!/^\d{4}-\d{2}-\d{2}$/.test(String(row.date||'')))throw new Error('วันที่ไม่ถูกต้อง');return{hotspotId:String(row.hotspotId||Utilities.getUuid()),date:String(row.date),time:String(row.time||''),provinceCode:provinceCode,districtCode:districtCode,subdistrictCode:subdistrictCode,landType:String(row.landType||''),plantType:String(row.plantType||''),latitude:latitude,longitude:longitude,source:String(row.source||'admin'),sourceId:String(row.sourceId||''),batchId:String(row.batchId||'')};}
function assertMutationScope_(actor,proposed,prior){if(!scopeAllows_(actor,proposed.provinceCode)||(prior&&!scopeAllows_(actor,String(prior.provinceCode))))throw new Error('จังหวัดอยู่นอกสิทธิ์');}
function listHotspots_(actor,payload){var code=provinceCodeFor_(actor,payload),includeDeleted=actor.role==='superadmin'&&payload.includeDeleted===true,items=provinceRows_(code,'Hotspots').filter(function(row){return includeDeleted||!row.deletedAt;}).slice(-5000).map(function(row){delete row._row;return row;});return{ok:true,provinceCode:code,rows:items};}
function saveHotspots_(actor,payload){var values=Array.isArray(payload.rows)?payload.rows:[];if(!values.length||values.length>5000)throw new Error('จำนวนแถวต้องอยู่ระหว่าง 1–5,000');var prepared=values.map(validateHotspot_),code=provinceCodeFor_(actor,{provinceCode:prepared[0].provinceCode}),ids=new Set();prepared.forEach(function(row){if(row.provinceCode!==code)throw new Error('หนึ่งชุดข้อมูลต้องเป็นจังหวัดเดียวกัน');if(ids.has(row.hotspotId))throw new Error('hotspotId ซ้ำในชุดข้อมูล');ids.add(row.hotspotId);});var lock=LockService.getScriptLock();lock.waitLock(20000);try{var existing=provinceRows_(code,'Hotspots'),byId=new Map(existing.map(function(row){return[String(row.hotspotId),row];}));prepared.forEach(function(row){assertMutationScope_(actor,row,byId.get(row.hotspotId));var prior=byId.get(row.hotspotId);if(prior&&['submitted','approved','published'].indexOf(String(prior.workflowStatus))>=0)throw new Error('ต้องนำรายการกลับเป็นฉบับร่างก่อนแก้ไข');});prepared.forEach(function(row){var prior=byId.get(row.hotspotId),stamp=now_(),value=Object.assign({},row,{workflowStatus:'draft',version:Number(prior&&prior.version||0)+1,createdAt:prior&&prior.createdAt||stamp,createdBy:prior&&prior.createdBy||actor.accountId,updatedAt:stamp,updatedBy:actor.accountId});if(prior)provinceUpdate_(code,'Hotspots',prior._row,value);else provinceAppend_(code,'Hotspots',value);});refreshRegistry_(code);provinceAudit_(actor,code,'save','batch','count='+prepared.length,'',null,{count:prepared.length});return{ok:true,saved:prepared.length,workflowStatus:'draft'};}finally{lock.releaseLock();}}
function selectedProvinceRows_(actor,payload){var code=provinceCodeFor_(actor,payload),ids=new Set((payload.hotspotIds||[]).map(String));if(!ids.size)throw new Error('ไม่ได้เลือกรายการ');var items=provinceRows_(code,'Hotspots').filter(function(row){return ids.has(String(row.hotspotId));});if(items.length!==ids.size)throw new Error('ไม่พบรายการที่เลือกบางรายการ');return{code:code,items:items};}
function transitionHotspots_(actor,payload,target){var selected=selectedProvinceRows_(actor,payload),allowed=target==='submitted'?['draft']:['submitted'];if(target==='approved'&&actor.role!=='superadmin')throw new Error('เฉพาะ Super Admin ที่อนุมัติข้อมูลได้');selected.items.forEach(function(row){if(row.deletedAt||allowed.indexOf(String(row.workflowStatus))<0)throw new Error('สถานะข้อมูลไม่รองรับการเปลี่ยนขั้นตอน');});var stamp=now_();selected.items.forEach(function(row){var patch={workflowStatus:target,updatedAt:stamp,updatedBy:actor.accountId};if(target==='submitted'){patch.submittedAt=stamp;patch.submittedBy=actor.accountId;}else{patch.approvedAt=stamp;patch.approvedBy=actor.accountId;}provinceUpdate_(selected.code,'Hotspots',row._row,patch);});refreshRegistry_(selected.code);provinceAudit_(actor,selected.code,target,'batch','count='+selected.items.length);return{ok:true,updated:selected.items.length,workflowStatus:target};}
function deleteHotspots_(actor,payload){var selected=selectedProvinceRows_(actor,payload),reason=String(payload.reason||'').trim();if(!reason)throw new Error('กรุณาระบุเหตุผลการลบ');var stamp=now_();selected.items.forEach(function(row){if(row.deletedAt)throw new Error('รายการถูกลบแล้ว');provinceUpdate_(selected.code,'Hotspots',row._row,{deletedAt:stamp,deletedBy:actor.accountId,deleteReason:reason,updatedAt:stamp,updatedBy:actor.accountId});});refreshRegistry_(selected.code);provinceAudit_(actor,selected.code,'soft_delete','batch','count='+selected.items.length,reason);return{ok:true,deleted:selected.items.length,recoverable:true};}
function restoreHotspots_(actor,payload){if(actor.role!=='superadmin')throw new Error('เฉพาะ Super Admin');var selected=selectedProvinceRows_(actor,payload),stamp=now_();selected.items.forEach(function(row){if(!row.deletedAt)throw new Error('รายการยังไม่ถูกลบ');provinceUpdate_(selected.code,'Hotspots',row._row,{deletedAt:'',deletedBy:'',deleteReason:'',workflowStatus:'draft',updatedAt:stamp,updatedBy:actor.accountId});});refreshRegistry_(selected.code);provinceAudit_(actor,selected.code,'restore','batch','count='+selected.items.length);return{ok:true,restored:selected.items.length};}
function publishHotspots_(actor,payload){if(actor.role!=='superadmin')throw new Error('เฉพาะ Super Admin ที่เผยแพร่ข้อมูลได้');var selected=selectedProvinceRows_(actor,payload),published=strictBoolean_(payload.published,false),stamp=now_();selected.items.forEach(function(row){if(row.deletedAt)throw new Error('ไม่สามารถเผยแพร่รายการที่ถูกลบ');if(published&&row.workflowStatus!=='approved')throw new Error('ต้องอนุมัติข้อมูลก่อนเผยแพร่');if(!published&&row.workflowStatus!=='published')throw new Error('รายการยังไม่ได้เผยแพร่');});selected.items.forEach(function(row){provinceUpdate_(selected.code,'Hotspots',row._row,{workflowStatus:published?'published':'approved',publishedAt:published?stamp:'',publishedBy:published?actor.accountId:'',updatedAt:stamp,updatedBy:actor.accountId});});refreshRegistry_(selected.code);provinceAudit_(actor,selected.code,published?'publish':'unpublish','batch','count='+selected.items.length);return{ok:true,updated:selected.items.length,published:published};}
function dashboard_(actor,payload){var code=provinceCodeFor_(actor,payload),counts={draft:0,submitted:0,approved:0,published:0,deleted:0};provinceRows_(code,'Hotspots').forEach(function(row){if(row.deletedAt)counts.deleted++;else if(Object.prototype.hasOwnProperty.call(counts,String(row.workflowStatus)))counts[String(row.workflowStatus)]++;});return{ok:true,provinceCode:code,counts:counts,total:Object.keys(counts).reduce(function(sum,key){return sum+counts[key];},0)};}

function publicRows_(code){try{return provinceRows_(code,'Hotspots').filter(function(row){return row.workflowStatus==='published'&&!row.deletedAt;});}catch(error){return[];}}
function publicCatalog_(){var codes=rows_('ProvinceRegistry').filter(function(row){return ['pilot','active'].indexOf(String(row.status))>=0&&Number(row.publishedCount)>0&&row.dataSpreadsheetId;}).map(function(row){return String(row.provinceCode);}).sort();return{ok:true,schemaVersion:2,activeProvinceCodes:codes};}
function publicHotspots_(code){if(!/^\d{2}$/.test(code))return{ok:false,error:'invalid_province'};var features=publicRows_(code).map(function(row){return{type:'Feature',geometry:{type:'Point',coordinates:[Number(row.longitude),Number(row.latitude)]},properties:{hotspotId:String(row.hotspotId),date:String(row.date),time:String(row.time||''),provinceCode:code,districtCode:String(row.districtCode),subdistrictCode:String(row.subdistrictCode||''),LandType:String(row.landType||''),PlantType:String(row.plantType||'')}};});return{type:'FeatureCollection',features:features,metadata:{provinceCode:code,totalPoints:features.length,public:true,schemaVersion:2}};}
function audit_(actor,action,targetType,targetId,provinceCode,result){append_('AuditLog',{timestamp:now_(),actorId:actor.accountId||'public',action:action,targetType:targetType,targetId:targetId,provinceCode:provinceCode||'',result:result});}

/** Run once from the Apps Script editor. The returned activation code is private. */
function bootstrapPrivate_(spreadsheetId,ownerUsername,ownerPassword,adminPhone){var properties=PropertiesService.getScriptProperties();if(!properties.getProperty('AUTH_PEPPER'))properties.setProperty('AUTH_PEPPER',random_());properties.setProperty('SPREADSHEET_ID',String(spreadsheetId));properties.setProperty('NOTICE_VERSION',NOTICE_VERSION);properties.setProperty('OWNER_USERNAME',String(ownerUsername));properties.setProperty('OWNER_PASSWORD_HASH',hashSecret_('owner-password',ownerPassword));properties.setProperty('OWNER_AUTH_REVISION','1');Object.keys(SHEETS).forEach(sheet_);var activationCode=random_().slice(0,16);if(!rows_('Accounts').some(function(row){return row.phoneHash===hashPhone_(adminPhone);})){append_('Accounts',{accountId:'A-KPP-001',phoneHash:hashPhone_(adminPhone),fullName:'ผู้ดูแลจังหวัดกำแพงเพชร',position:'ผู้ดูแลระบบ',positionOther:'',affiliation:'สำนักงานเกษตรจังหวัด',provinceCode:'62',districtCodes:'',role:'admin',status:'approved',revision:1,deviceTokenHash:'',activationHash:hashSecret_('activation',activationCode),createdAt:now_(),approvedAt:now_(),activationExpiresAt:activationExpiry_()});}return{spreadsheetId:spreadsheetId,adminActivationCode:activationCode};}
