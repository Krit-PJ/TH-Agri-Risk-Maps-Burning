/** Thailand Agri-Risk Maps Burning V2 control plane.
 * Public data uses doGet JSON/JSONP. Registration and admin calls run inside
 * this Apps Script Web App through google.script.run; no credential is stored
 * in the GitHub repository.
 */
var NOTICE_VERSION='2026-10-21.1',SESSION_SECONDS=21600;
var SHEETS={
 Accounts:['accountId','phoneHash','fullName','position','positionOther','affiliation','provinceCode','districtCodes','role','status','revision','deviceTokenHash','activationHash','createdAt','approvedAt'],
 RegistrationRequests:['requestId','idempotencyKey','phoneHash','fullName','position','positionOther','affiliation','provinceCode','noticeVersion','acknowledgedAt','status','createdAt'],
 Hotspots:['hotspotId','date','time','provinceCode','districtCode','subdistrictCode','landType','plantType','latitude','longitude','published','source','updatedAt','updatedBy'],
 AuditLog:['timestamp','actorId','action','targetType','targetId','provinceCode','result'],Settings:['key','value']};

function doGet(e){var action=String(e&&e.parameter&&e.parameter.action||'app');if(action==='health')return output_({ok:true,service:'TH-Agri-Risk-Maps-Burning',mode:'workspace-control-plane',version:2},e);if(action==='catalog')return output_(publicCatalog_(),e);if(action==='hotspots')return output_(publicHotspots_(String(e.parameter.provinceCode||'')),e);return HtmlService.createTemplateFromFile('Index').evaluate().setTitle('Thailand Agri-Risk Maps Burning · ลงทะเบียนและจัดการข้อมูล').setXFrameOptionsMode(HtmlService.XFrameOptionsMode.DEFAULT);}
function include_(name){return HtmlService.createHtmlOutputFromFile(name).getContent();}
function output_(value,e){var json=JSON.stringify(value),callback=String(e&&e.parameter&&e.parameter.callback||'');if(callback){if(!/^[A-Za-z_$][0-9A-Za-z_$\.]{0,79}$/.test(callback))return ContentService.createTextOutput('invalid callback').setMimeType(ContentService.MimeType.TEXT);return ContentService.createTextOutput(callback+'('+json+');').setMimeType(ContentService.MimeType.JAVASCRIPT);}return ContentService.createTextOutput(json).setMimeType(ContentService.MimeType.JSON);}

function api(action,payload){payload=payload||{};try{if(action==='register')return register_(payload);if(action==='registrationStatus')return registrationStatus_(payload);if(action==='login')return login_(payload);if(action==='logout')return logout_(payload);var session=requireSession_(payload.sessionToken);if(action==='mySession')return{ok:true,session:publicAccount_(session)};if(action==='listRequests')return listRequests_(session);if(action==='approveRequest')return approveRequest_(session,payload);if(action==='listAccounts')return listAccounts_(session);if(action==='saveHotspots')return saveHotspots_(session,payload);if(action==='deleteHotspots')return deleteHotspots_(session,payload);if(action==='publishHotspots')return publishHotspots_(session,payload);throw new Error('ไม่รู้จักคำสั่งที่ร้องขอ');}catch(error){return{ok:false,error:String(error&&error.message||error)};}}

function normalizePhone_(value){var thai='๐๑๒๓๔๕๖๗๘๙',digits=String(value||'').replace(/[๐-๙]/g,function(c){return String(thai.indexOf(c));}).replace(/\D/g,'');if(!/^0[689]\d{8}$/.test(digits))throw new Error('หมายเลขโทรศัพท์มือถือไม่ถูกต้อง');return digits;}
function digest_(value){var bytes=Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,String(value),Utilities.Charset.UTF_8);return Utilities.base64EncodeWebSafe(bytes).replace(/=+$/,'');}
function pepper_(){var value=PropertiesService.getScriptProperties().getProperty('AUTH_PEPPER');if(!value)throw new Error('ระบบยังไม่ได้ตั้งค่า AUTH_PEPPER');return value;}
function hashPhone_(phone){return digest_(pepper_()+'|phone|'+normalizePhone_(phone));}
function hashSecret_(label,value){return digest_(pepper_()+'|'+label+'|'+String(value||''));}

function validateRegistration_(payload,noticeVersion,existingKeys){if(!payload.acknowledged||String(payload.noticeVersion)!==String(noticeVersion))throw new Error('กรุณาอ่านและรับทราบประกาศฉบับปัจจุบัน');var key=String(payload.idempotencyKey||'').trim();if(!/^[A-Za-z0-9_-]{12,100}$/.test(key))throw new Error('รหัสป้องกันการส่งซ้ำไม่ถูกต้อง');var name=String(payload.fullName||'').trim();if(name.length<3||name.length>120)throw new Error('กรุณาระบุชื่อ-สกุล');var position=String(payload.position||'').trim(),allowed=['นักวิชาการส่งเสริมการเกษตร','นักวิชาการเกษตร','เกษตรอำเภอ','อื่นๆ'];if(allowed.indexOf(position)<0)throw new Error('ตำแหน่งไม่ถูกต้อง');var other=String(payload.positionOther||'').trim();if(position==='อื่นๆ'&&!other)throw new Error('กรุณาระบุตำแหน่งอื่น');var affiliation=String(payload.affiliation||'').trim();if(['สำนักงานเกษตรอำเภอ','สำนักงานเกษตรจังหวัด'].indexOf(affiliation)<0)throw new Error('สังกัดไม่ถูกต้อง');var code=String(payload.provinceCode||'');if(!/^\d{2}$/.test(code))throw new Error('จังหวัดไม่ถูกต้อง');return{duplicate:existingKeys.has(key),idempotencyKey:key,fullName:name,phone:normalizePhone_(payload.phone),position:position,positionOther:other,affiliation:affiliation,provinceCode:code};}
function scopeAllows_(actor,provinceCode){return!!actor&&actor.status==='approved'&&(actor.role==='superadmin'||(actor.role==='admin'&&actor.provinceCode===String(provinceCode||'')));}
function sessionValid_(session,now){return!!session&&Number(session.expiresAt)>Number(now);}
function publicAccount_(row){return{accountId:row.accountId,fullName:row.fullName,role:row.role,provinceCode:row.provinceCode};}

function spreadsheet_(){var id=PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID');if(!id)throw new Error('ระบบยังไม่ได้ตั้งค่า SPREADSHEET_ID');return SpreadsheetApp.openById(id);}
function sheet_(name){var book=spreadsheet_(),sheet=book.getSheetByName(name);if(!sheet)sheet=book.insertSheet(name);var expected=SHEETS[name];if(!expected)throw new Error('Unknown table '+name);if(sheet.getLastRow()===0)sheet.getRange(1,1,1,expected.length).setValues([expected]);var actual=sheet.getRange(1,1,1,expected.length).getDisplayValues()[0];if(expected.join('|')!==actual.join('|'))throw new Error('โครงสร้างชีต '+name+' ไม่ตรงกับระบบ');sheet.setFrozenRows(1);return sheet;}
function rows_(name){var sheet=sheet_(name),values=sheet.getDataRange().getValues(),headers=values.shift().map(String);return values.filter(function(row){return row.some(function(value){return value!=='';});}).map(function(row,index){var value={_row:index+2};headers.forEach(function(header,column){value[header]=row[column];});return value;});}
function append_(name,value){var sheet=sheet_(name),headers=SHEETS[name];sheet.appendRow(headers.map(function(header){return value[header]===undefined?'':value[header];}));}
function update_(name,rowNumber,patch){var sheet=sheet_(name),headers=SHEETS[name],values=sheet.getRange(rowNumber,1,1,headers.length).getValues()[0];headers.forEach(function(header,index){if(Object.prototype.hasOwnProperty.call(patch,header))values[index]=patch[header];});sheet.getRange(rowNumber,1,1,headers.length).setValues([values]);}
function now_(){return new Date().toISOString();}function random_(){return Utilities.getUuid().replace(/-/g,'')+Utilities.getUuid().replace(/-/g,'');}

function register_(payload){var lock=LockService.getScriptLock();lock.waitLock(10000);try{var existing=rows_('RegistrationRequests'),keys=new Set(existing.map(function(row){return String(row.idempotencyKey);})),value=validateRegistration_(payload,PropertiesService.getScriptProperties().getProperty('NOTICE_VERSION')||NOTICE_VERSION,keys),prior=existing.find(function(row){return String(row.idempotencyKey)===value.idempotencyKey;});if(prior)return{ok:true,duplicate:true,requestId:prior.requestId,status:prior.status};var requestId='R-'+Utilities.getUuid();append_('RegistrationRequests',{requestId:requestId,idempotencyKey:value.idempotencyKey,phoneHash:hashPhone_(value.phone),fullName:value.fullName,position:value.position,positionOther:value.positionOther,affiliation:value.affiliation,provinceCode:value.provinceCode,noticeVersion:payload.noticeVersion,acknowledgedAt:now_(),status:'pending',createdAt:now_()});audit_({accountId:'public'},'register','RegistrationRequest',requestId,value.provinceCode,'pending');return{ok:true,duplicate:false,requestId:requestId,status:'pending'};}finally{lock.releaseLock();}}
function registrationStatus_(payload){var key=String(payload.idempotencyKey||''),row=rows_('RegistrationRequests').find(function(value){return String(value.idempotencyKey)===key;});return row?{ok:true,found:true,requestId:row.requestId,status:row.status}:{ok:true,found:false};}

function login_(payload){var properties=PropertiesService.getScriptProperties(),actor;if(payload.username){if(String(payload.username)!==properties.getProperty('OWNER_USERNAME')||hashSecret_('owner-password',payload.password)!==properties.getProperty('OWNER_PASSWORD_HASH'))throw new Error('ชื่อผู้ใช้หรือรหัสผ่านไม่ถูกต้อง');actor={accountId:'OWNER',fullName:String(payload.username),role:'superadmin',provinceCode:'',status:'approved'};}else{var phoneHash=hashPhone_(payload.phone),accounts=rows_('Accounts');actor=accounts.find(function(row){return row.phoneHash===phoneHash&&row.status==='approved';});if(!actor)throw new Error('บัญชียังไม่ได้รับอนุมัติหรือหมายเลขไม่ถูกต้อง');var deviceToken=String(payload.deviceToken||'');if(deviceToken.length<32)throw new Error('อุปกรณ์นี้ยังไม่มีรหัสยืนยัน');var deviceHash=hashSecret_('device',deviceToken);if(!actor.deviceTokenHash){if(!payload.activationCode||hashSecret_('activation',payload.activationCode)!==actor.activationHash)throw new Error('กรุณาระบุรหัสเปิดใช้งานครั้งแรกจาก Super Admin');update_('Accounts',actor._row,{deviceTokenHash:deviceHash,activationHash:'',revision:Number(actor.revision||0)+1});}else if(actor.deviceTokenHash!==deviceHash)throw new Error('อุปกรณ์นี้ยังไม่ได้รับอนุญาต กรุณาขอรหัสเปิดใช้งานใหม่');}
 var token=random_(),session={accountId:actor.accountId,fullName:actor.fullName,role:actor.role,provinceCode:String(actor.provinceCode||''),status:'approved',expiresAt:Date.now()+SESSION_SECONDS*1000};CacheService.getScriptCache().put('session:'+hashSecret_('session',token),JSON.stringify(session),SESSION_SECONDS);audit_(session,'login','Session',session.accountId,session.provinceCode,'success');return{ok:true,sessionToken:token,session:publicAccount_(session),expiresAt:session.expiresAt};}
function requireSession_(token){var raw=CacheService.getScriptCache().get('session:'+hashSecret_('session',String(token||''))),session=raw&&JSON.parse(raw);if(!sessionValid_(session,Date.now()))throw new Error('เซสชันหมดอายุ กรุณาเข้าสู่ระบบใหม่');return session;}
function logout_(payload){if(payload.sessionToken)CacheService.getScriptCache().remove('session:'+hashSecret_('session',payload.sessionToken));return{ok:true};}
function listRequests_(actor){if(actor.role!=='superadmin')throw new Error('เฉพาะ Super Admin');return{ok:true,requests:rows_('RegistrationRequests').map(function(row){return{requestId:row.requestId,fullName:row.fullName,position:row.position,positionOther:row.positionOther,affiliation:row.affiliation,provinceCode:String(row.provinceCode),noticeVersion:row.noticeVersion,status:row.status,createdAt:row.createdAt};})};}
function approveRequest_(actor,payload){if(actor.role!=='superadmin')throw new Error('เฉพาะ Super Admin');var lock=LockService.getScriptLock();lock.waitLock(10000);try{var request=rows_('RegistrationRequests').find(function(row){return row.requestId===payload.requestId;});if(!request||request.status!=='pending')throw new Error('ไม่พบคำขอ pending');var activationCode=String(Math.floor(100000+Math.random()*900000)),accountId='A-'+Utilities.getUuid();append_('Accounts',{accountId:accountId,phoneHash:request.phoneHash,fullName:request.fullName,position:request.position,positionOther:request.positionOther,affiliation:request.affiliation,provinceCode:String(request.provinceCode),districtCodes:'',role:'admin',status:'approved',revision:1,deviceTokenHash:'',activationHash:hashSecret_('activation',activationCode),createdAt:request.createdAt,approvedAt:now_()});update_('RegistrationRequests',request._row,{status:'approved'});audit_(actor,'approve','Account',accountId,String(request.provinceCode),'success');return{ok:true,account:publicAccount_({accountId:accountId,fullName:request.fullName,role:'admin',provinceCode:String(request.provinceCode)}),activationCode:activationCode};}finally{lock.releaseLock();}}
function listAccounts_(actor){if(actor.role!=='superadmin')throw new Error('เฉพาะ Super Admin');return{ok:true,accounts:rows_('Accounts').map(publicAccount_)};}

function validateHotspot_(row){var provinceCode=String(row.provinceCode||''),districtCode=String(row.districtCode||''),subdistrictCode=String(row.subdistrictCode||'');if(!/^\d{2}$/.test(provinceCode)||!/^\d{4}$/.test(districtCode)||districtCode.slice(0,2)!==provinceCode)throw new Error('รหัสพื้นที่ไม่ถูกต้อง');if(subdistrictCode&&(!/^\d{6}$/.test(subdistrictCode)||subdistrictCode.slice(0,4)!==districtCode))throw new Error('รหัสตำบลไม่ถูกต้อง');var latitude=Number(row.latitude),longitude=Number(row.longitude);if(!Number.isFinite(latitude)||!Number.isFinite(longitude)||latitude<0||latitude>25||longitude<90||longitude>110)throw new Error('พิกัดไม่ถูกต้อง');if(!/^\d{4}-\d{2}-\d{2}$/.test(String(row.date||'')))throw new Error('วันที่ไม่ถูกต้อง');return{hotspotId:String(row.hotspotId||Utilities.getUuid()),date:String(row.date),time:String(row.time||''),provinceCode:provinceCode,districtCode:districtCode,subdistrictCode:subdistrictCode,landType:String(row.landType||''),plantType:String(row.plantType||''),latitude:latitude,longitude:longitude,published:Boolean(row.published),source:String(row.source||'admin')};}
function saveHotspots_(actor,payload){var values=Array.isArray(payload.rows)?payload.rows:[];if(!values.length||values.length>5000)throw new Error('จำนวนแถวต้องอยู่ระหว่าง 1–5,000');var prepared=values.map(validateHotspot_);prepared.forEach(function(row){if(!scopeAllows_(actor,row.provinceCode))throw new Error('จังหวัดอยู่นอกสิทธิ์');});var lock=LockService.getScriptLock();lock.waitLock(20000);try{var existing=rows_('Hotspots'),byId=new Map(existing.map(function(row){return[String(row.hotspotId),row];}));prepared.forEach(function(row){var value=Object.assign(row,{updatedAt:now_(),updatedBy:actor.accountId}),prior=byId.get(row.hotspotId);if(prior)update_('Hotspots',prior._row,value);else append_('Hotspots',value);});audit_(actor,'save','Hotspot','batch',prepared[0].provinceCode,'count='+prepared.length);return{ok:true,saved:prepared.length};}finally{lock.releaseLock();}}
function deleteHotspots_(actor,payload){var ids=new Set((payload.hotspotIds||[]).map(String));if(!ids.size)throw new Error('ไม่ได้เลือกรายการ');var sheet=sheet_('Hotspots'),items=rows_('Hotspots').filter(function(row){return ids.has(String(row.hotspotId));});items.forEach(function(row){if(!scopeAllows_(actor,String(row.provinceCode)))throw new Error('จังหวัดอยู่นอกสิทธิ์');});items.sort(function(a,b){return b._row-a._row;}).forEach(function(row){sheet.deleteRow(row._row);});audit_(actor,'delete','Hotspot','batch',items[0]&&String(items[0].provinceCode),'count='+items.length);return{ok:true,deleted:items.length};}
function publishHotspots_(actor,payload){var ids=new Set((payload.hotspotIds||[]).map(String)),published=Boolean(payload.published),items=rows_('Hotspots').filter(function(row){return ids.has(String(row.hotspotId));});items.forEach(function(row){if(!scopeAllows_(actor,String(row.provinceCode)))throw new Error('จังหวัดอยู่นอกสิทธิ์');update_('Hotspots',row._row,{published:published,updatedAt:now_(),updatedBy:actor.accountId});});audit_(actor,'publish','Hotspot','batch',items[0]&&String(items[0].provinceCode),'published='+published+',count='+items.length);return{ok:true,updated:items.length};}

function publicRows_(){return rows_('Hotspots').filter(function(row){return String(row.published).toLowerCase()==='true';});}
function publicCatalog_(){var codes=Array.from(new Set(publicRows_().map(function(row){return String(row.provinceCode);}))).sort();return{ok:true,schemaVersion:1,activeProvinceCodes:codes};}
function publicHotspots_(code){if(!/^\d{2}$/.test(code))return{ok:false,error:'invalid_province'};var features=publicRows_().filter(function(row){return String(row.provinceCode)===code;}).map(function(row){return{type:'Feature',geometry:{type:'Point',coordinates:[Number(row.longitude),Number(row.latitude)]},properties:{hotspotId:String(row.hotspotId),date:String(row.date),time:String(row.time||''),provinceCode:code,districtCode:String(row.districtCode),subdistrictCode:String(row.subdistrictCode||''),LandType:String(row.landType||''),PlantType:String(row.plantType||'')}};});return{type:'FeatureCollection',features:features,metadata:{provinceCode:code,totalPoints:features.length,public:true}};}
function audit_(actor,action,targetType,targetId,provinceCode,result){append_('AuditLog',{timestamp:now_(),actorId:actor.accountId||'public',action:action,targetType:targetType,targetId:targetId,provinceCode:provinceCode||'',result:result});}

/** Run once from the Apps Script editor. The returned activation code is private. */
function bootstrapPrivate_(spreadsheetId,ownerUsername,ownerPassword,adminPhone){var properties=PropertiesService.getScriptProperties();if(!properties.getProperty('AUTH_PEPPER'))properties.setProperty('AUTH_PEPPER',random_());properties.setProperty('SPREADSHEET_ID',String(spreadsheetId));properties.setProperty('NOTICE_VERSION',NOTICE_VERSION);properties.setProperty('OWNER_USERNAME',String(ownerUsername));properties.setProperty('OWNER_PASSWORD_HASH',hashSecret_('owner-password',ownerPassword));Object.keys(SHEETS).forEach(sheet_);var activationCode=String(Math.floor(100000+Math.random()*900000));if(!rows_('Accounts').some(function(row){return row.phoneHash===hashPhone_(adminPhone);})){append_('Accounts',{accountId:'A-KPP-001',phoneHash:hashPhone_(adminPhone),fullName:'ผู้ดูแลจังหวัดกำแพงเพชร',position:'ผู้ดูแลระบบ',positionOther:'',affiliation:'สำนักงานเกษตรจังหวัด',provinceCode:'62',districtCodes:'',role:'admin',status:'approved',revision:1,deviceTokenHash:'',activationHash:hashSecret_('activation',activationCode),createdAt:now_(),approvedAt:now_()});}return{spreadsheetId:spreadsheetId,adminActivationCode:activationCode};}
